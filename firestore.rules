rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /responses/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','answer','noPresses','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 40
        && request.resource.data.answer in ['YES','NO']
        && request.resource.data.noPresses is int
        && request.resource.data.noPresses >= 0
        && request.resource.data.noPresses <= 6;
      allow read, update, delete: if request.auth != null
        && request.auth.token.email == 'sandip2007mukherjee@gmail.com';
    }
  }
}